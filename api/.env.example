# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
# Postgres instead of SQLite (production). Free: https://neon.tech → Connection string.
# DATABASE_URL=postgres://user:password@host/dbname
# DATABASE_SSL=false   # only for a local Postgres without TLS
# RabbitMQ for the confirmation mails. Free: https://www.cloudamqp.com (Little Lemur) → AMQP URL.
# Without it an in-process broker is used (fine locally; unsent mails are lost on restart).
# AMQP_URL=amqps://user:password@host/vhost
# OUTBOX_POLL_INTERVAL_MS=5000
# Confirmation mail. Without SMTP_URL mails are only logged.
# Free test inbox: https://ethereal.email (Create Ethereal Account) → smtp://user:pass@smtp.ethereal.email:587
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Campus Events <no-reply@example.com>
# MAIL_TIMEOUT_MS=10000
# A failed mail waits this long in the retry queue, then is tried again (no attempt limit).
# MAIL_RETRY_DELAY_MS=60000
# Cache for GET endpoints. Writes invalidate it immediately; the TTL is only a safety net.
# CACHE_TTL_SECONDS=60
