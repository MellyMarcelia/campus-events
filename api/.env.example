# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672
# Confirmation mail. Without SMTP_URL mails are only logged.
# Free test inbox: https://ethereal.email (Create Ethereal Account) → smtp://user:pass@smtp.ethereal.email:587
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Campus Events <no-reply@example.com>
# MAIL_TIMEOUT_MS=10000
